      "typeVersion": 2,
      "id": "6e75cc1d-4b84-452b-9219-448132b02755",
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const allowedRecipient = \"sender@example.com\";\nconst b = $json.body || {};\nconst subject = `EŞİK | ${b.company_id} | Şirket risk raporu`;\nconst ok = /^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$/.test(allowedRecipient)\n  && b.recipient === allowedRecipient && /^ESIK-\\d{5}$/.test(b.company_id || '')\n  && /^[0-9a-f-]{36}$/i.test(b.request_id || '')\n  && b.subject === subject && typeof b.report_text === 'string'\n  && b.report_text.length >= 50 && b.report_text.length <= 30000\n  && !b.report_text.includes('\\u0000')\n  && b.report_version === 'esik-report-2'\n  && typeof b.report_html === 'string' && b.report_html.length >= 1000 && b.report_html.length <= 100000\n  && b.report_html.includes('name=\"esik-report-version\" content=\"esik-report-2\"')\n  && !/<(?:script|iframe|object|embed|form|input|link|meta[^>]+http-equiv)\\b|\\bon\\w+\\s*=|javascript\\s*:|(?:src|href)\\s*=/i.test(b.report_html);\nreturn [{json: {ok, recipient: allowedRecipient, request_id: String(b.request_id || ''),\n  subject, report_text: ok ? b.report_text : '', report_html: ok ? b.report_html : '', company_id: b.company_id || ''}}];"
      }
    },
    {
      "name": "Rapor Geçerli mi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "id": "3441b513-d64d-4726-b8a6-532a8206af79",
      "position": [
